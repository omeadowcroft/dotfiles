  },
  "custom/ws-watch": {
    "exec": "$HOME/.config/waybar/scripts/ws-watch.py",
    "tooltip": false
  },
  "group/desktops": {
    "orientation": "horizontal",
    "modules": [
      "custom/ws1",
      "custom/ws2",
      "custom/ws3",
      "custom/ws4",
      "custom/ws5",
      "custom/ws6",
      "custom/ws7",
      "custom/ws8",
      "custom/ws9",
      "custom/ws10",
      "custom/ws-watch"
    ]
  }
}