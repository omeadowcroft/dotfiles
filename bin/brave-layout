#!/usr/bin/env python3
import json, os, socket, subprocess, sys, time

STATE_DIR = os.path.expanduser("~/.local/state/brave-layout")
LOG = os.path.expanduser("~/.local/state/brave-layout.log")
WRAPPER = os.path.expanduser("~/.local/bin/brave")
DEVNULL = subprocess.DEVNULL

def hc(*args):
    return json.loads(subprocess.check_output(["hyprctl", *args, "-j"]))

def brave_windows():
    return [c for c in hc("clients") if c.get("class", "").lower().startswith("brave")]

def dispatch(expr):
    r = subprocess.run(["hyprctl", "dispatch", expr], capture_output=True, text=True)
    with open(LOG, "a") as f:
        f.write("%s -> %s %s\n" % (expr, r.stdout.strip(), r.stderr.strip()))

def lua(v):
    return str(v) if isinstance(v, int) else '"%s"' % v

def target(ws):
    return ws["id"] if ws["id"] > 0 else ws["name"]

def launch(*args):
    subprocess.Popen([WRAPPER, *args], stdout=DEVNULL, stderr=DEVNULL, start_new_session=True)

def layout_path(name):
    return os.path.join(STATE_DIR, name + ".json")

mode = sys.argv[1]

if mode == "save":
    name = sys.argv[2]
    wins = [{"ws": {"id": c["workspace"]["id"], "name": c["workspace"]["name"]},
             "title": c.get("title", ""), "at": c["at"], "size": c["size"],
             "floating": c.get("floating", False)} for c in brave_windows()]
    os.makedirs(STATE_DIR, exist_ok=True)
    json.dump({"windows": wins}, open(layout_path(name), "w"))

elif mode == "restore":
    name, prev = sys.argv[2], sys.argv[3]
    entries = None
    for n in (name, prev):
        try:
            entries = json.load(open(layout_path(n)))["windows"]
            break
        except Exception:
            pass
    if not entries:
        launch("--restore-last-session")
        sys.exit(0)

    start_active = hc("activeworkspace")["id"]
    entries = sorted(entries, key=lambda o: o["ws"]["id"] if o["ws"]["id"] > 0 else 10**6)
    for e in entries:
        e["done"] = False
    wins = {}

    path = "%s/hypr/%s/.socket2.sock" % (os.environ["XDG_RUNTIME_DIR"], os.environ["HYPRLAND_INSTANCE_SIGNATURE"])
    s = socket.socket(socket.AF_UNIX)
    s.connect(path)
    s.settimeout(0.3)
    buf = ""

    def poll(wait):
        global buf
        out, end = [], time.time() + wait
        while time.time() < end:
            try:
                data = s.recv(4096)
            except socket.timeout:
                continue
            if not data:
                break
            buf += data.decode(errors="ignore")
            while "\n" in buf:
                line, buf = buf.split("\n", 1)
                out.append(line)
            if out:
                break
        return out

    def move(addr, e):
        e["done"] = True
        wins[addr]["done"] = True
        wins[addr]["entry"] = e
        if wins[addr].get("ws") != e["ws"]["name"]:
            dispatch('hl.dsp.window.move({ workspace = %s, window = "address:0x%s" })'
                     % (lua(target(e["ws"])), addr))

    def try_assign(addr):
        w = wins[addr]
        if w["done"]:
            return
        for e in entries:
            if not e["done"] and e["title"] and e["title"] == w["title"]:
                move(addr, e)
                return

    def handle(line):
        if line.startswith("openwindow>>"):
            addr, wsname, cls, title = (line[12:].split(",", 3) + ["", "", "", ""])[:4]
            if not cls.lower().startswith("brave"):
                return False
            wins[addr] = {"title": title, "ws": wsname, "done": False}
            try_assign(addr)
            return True
        if line.startswith("windowtitlev2>>"):
            addr, title = (line[15:].split(",", 1) + ["", ""])[:2]
            if addr in wins:
                wins[addr]["title"] = title
                try_assign(addr)
                return True
        if line.startswith("closewindow>>"):
            wins.pop(line[13:], None)
        return False

    launch("--restore-last-session")
    deadline = time.time() + 45
    last_event, launches = time.time(), 0
    while time.time() < deadline:
        if all(e["done"] for e in entries):
            break
        got = False
        for line in poll(0.4):
            if handle(line):
                got = True
        if got:
            last_event = time.time()
        idle = time.time() - last_event
        if wins and len(wins) < len(entries) and idle > 1.5 and launches < 2 * len(entries):
            before = len(wins)
            launches += 1
            launch("--new-window")
            until = time.time() + 8
            while len(wins) == before and time.time() < until:
                for line in poll(0.3):
                    handle(line)
            last_event = time.time()
        elif wins and len(wins) >= len(entries) and idle > 5:
            break

    # anything still unmatched takes the remaining places in order
    left = [e for e in entries if not e["done"]]
    for addr, w in list(wins.items()):
        if not w["done"] and left:
            move(addr, left.pop(0))

    # put windows on the right side of a split: compare with where each one used to sit
    time.sleep(0.8)
    for _ in range(2):
        cur = {c["address"]: c for c in brave_windows()}
        everything = hc("clients")
        for addr, w in list(wins.items()):
            e = w.get("entry")
            c = cur.get("0x" + addr)
            if not e or not c or "at" not in e or e.get("floating") or c.get("floating"):
                continue
            others = [x for x in everything
                      if x["workspace"]["id"] == c["workspace"]["id"]
                      and x["address"] != c["address"] and not x.get("floating")]
            if not others:
                continue
            dx = (e["at"][0] + e["size"][0] / 2) - (c["at"][0] + c["size"][0] / 2)
            dy = (e["at"][1] + e["size"][1] / 2) - (c["at"][1] + c["size"][1] / 2)
            if abs(dx) > e["size"][0] / 2:
                d = "l" if dx < 0 else "r"
            elif abs(dy) > e["size"][1] / 2:
                d = "u" if dy < 0 else "d"
            else:
                continue
            dispatch('hl.dsp.window.move({ direction = "%s", window = "address:0x%s" })' % (d, addr))
        time.sleep(0.5)

    if start_active > 0:
        dispatch("hl.dsp.focus({ workspace = %d })" % start_active)
